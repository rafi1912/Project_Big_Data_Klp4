# Salin menjadi .env di root repo, lalu ganti setiap <...>. File .env TIDAK pernah di-commit (.gitignore).
# Dibaca oleh: docker compose (--env-file .env), src/common.py (get_mongo), src/synthesis.py, dashboard.

# --- MongoDB (deploy/mongodb/docker-compose.yml) -----------------------------------------
MONGO_INITDB_ROOT_USERNAME=<user-admin>
MONGO_INITDB_ROOT_PASSWORD=<password-panjang-acak>
MONGO_PORT=27017
MONGO_DB=socmed_bot_detection
# Opsional. Bila kosong, URI dirakit dari user/password di atas + MONGO_HOST (default 127.0.0.1)
# dan MONGO_PORT. Isi hanya bila MongoDB ada di tempat lain (mis. Atlas):
# MONGO_URI=mongodb://<user>:<password>@<host>:<port>/?authSource=admin

# --- Kaggle (scripts/download_datasets.py) ------------------------------------------------
# Tidak perlu bila sudah ada ~/.kaggle/kaggle.json atau ~/.kaggle/access_token.
# Skrip unduh tidak membaca .env sendiri: jalankan `set -a; . ./.env; set +a` dulu.
# KAGGLE_USERNAME=<username-kaggle>
# KAGGLE_KEY=<api-key-kaggle>
