        "account_age_days": 8
      },
      "rf_inner_validation_roc_auc": {
        "with_all_three": 0.9266,
        "without_statuses (used)": 0.9241,
        "scope": "80:20 stratified split inside the training data; test split not used"
      },
      "lr_bootstrap_coefficients": {
        "with_all_three": {
          "log_statuses_count": {
            "mean": -0.0862,
