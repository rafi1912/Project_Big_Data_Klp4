      "ru",
      "sl",
      "so",
      "sv",
      "sw",
      "tl",
      "tr",
      "vi",
      "zh-cn"
    ],
    "dropped": {
      "id": "identifier (contract rule 1); also a proxy for creation time",
      "screen_name": "identifier (contract rule 1)",
      "Unnamed row index (_c0)": "file row number",
      "profile_image_url": "URL artifact (string value carries no behaviour)",
      "profile_background_image_url": "URL artifact; its NULLs encode account era + default_profile",
      "profile_image_path": "local download path; 35% NULL by download completeness, label-dependent -> leakage risk",
      "profile_background_image_path": "same as profile_image_path",
      "split": "vendor's own partition, not an account property",
      "statuses_count": "= average_tweets_per_day x account_age_days by construction (see collinearity)",
      "created_at": "= collection date - account_age_days by construction",
      "description (raw text)": "replaced by has_description and description_length",
      "location (raw text)": "replaced by has_location",
      "lang (raw)": "replaced by lang_cat (one-hot)"
    },
    "engineered": {
      "log_favourites_count": "ln(1 + favourites_count)",
      "log_followers_count": "ln(1 + followers_count)",
      "log_friends_count": "ln(1 + friends_count)",
      "follower_share": "(followers_count + 1) / (followers_count + friends_count + 2) = r / (1 + r), r = (followers + 1) / (friends + 1): the followers/friends ratio as a bounded 0-1 share; +1/+2 smoothing guards divide-by-zero (no followers and no friends -> 0.5)",
      "log_average_tweets_per_day": "ln(1 + average_tweets_per_day)",
      "has_description": "1 if description is non-empty",
      "description_length": "characters in description; 0 for an empty bio (true value)",
      "has_location": "1 if location is set and not the placeholder 'unknown'",
      "lang_cat": "lang; NULL -> explicit '__missing__' level; levels with < 30 training accounts -> '__other__'; one-hot (dropLast) for both models",
      "booleans": "default_profile, default_profile_image, geo_enabled, verified: 'True'/'False' -> 1.0/0.0"
    },
    "missing_values": {
      "lang": "21.3% NULL -> its own category '__missing__' (informative: 13.8% of humans, 36.2% of bots)",
      "description": "19.4% NULL = empty bio -> has_description 0, length 0",
      "location": "4 NULL + 34.8% 'unknown' placeholder -> has_location 0",
      "all model inputs": "asserted NULL-free after the rules above; nothing zero-filled"
    },
    "collinearity": {
      "identity_tested": "statuses_count == average_tweets_per_day * account_age_days",
      "pearson_r_statuses_vs_rate_x_age": 1.0,
      "share_rows_exact_within_rounding": 1.0,
      "median_relative_error": 0.000126,
      "log_space_regression": {
        "model": "ln(statuses) = b0 + b1 ln(rate) + b2 ln(age)",
        "rows_with_all_positive": 29909,
        "r2": 0.999929,
        "b1_ln_rate": 1.0003,
        "b2_ln_age": 1.0,
        "implied_vif_of_ln_statuses": 14017.4
      },
      "vif_with_statuses_count": {
        "log_favourites_count": 1.63,
        "log_followers_count": 6.05,
        "log_friends_count": 5.6,
        "follower_share": 4.56,
        "log_average_tweets_per_day": 5.61,
        "account_age_days": 1.56,
        "has_description": 1.64,
        "description_length": 1.71,
        "has_location": 1.26,
        "log_statuses_count": 6.93
      },
      "vif_used_feature_set": {
        "log_favourites_count": 1.5,
        "log_followers_count": 5.91,
        "log_friends_count": 5.59,
        "follower_share": 4.53,
        "log_average_tweets_per_day": 1.67,
        "account_age_days": 1.33,
        "has_description": 1.63,
        "description_length": 1.71,
        "has_location": 1.24
      },
      "ratio_redesign": {
        "first_version": "ln((followers + 1) / (friends + 1))",
        "problem": "identical to log_followers_count - log_friends_count, an exact linear combination of two other features (found by this VIF check)",
        "vif_first_version": {
          "log_followers_count": "inf (exact linear combination)",
          "log_friends_count": "inf (exact linear combination)",
          "_ratio_log_v1": "inf (exact linear combination)"
        },
        "fix": "follower_share = r / (1 + r); same ordering as the ratio (so Random Forest splits are unchanged) but no longer a linear combination of the logs"
      },
      "rf_impurity_importance_with_all_three": {
        "log_statuses_count": 0.0702,
        "log_average_tweets_per_day": 0.0739,
        "account_age_days": 0.0544
      },
      "rf_impurity_rank_with_all_three": {
