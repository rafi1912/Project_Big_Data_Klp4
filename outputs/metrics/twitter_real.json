{
  "platform": "twitter",
  "dataset": {
    "name": "Twitter Human/Bots Dataset (real accounts)",
    "source": "kaggle: danieltreiman/twitter-human-bots-dataset",
    "file": "data/landing/twitter_human_bots/twitter_human_bots_dataset.csv",
    "n_rows": 37438,
    "label_col": "account_type",
    "positive_means": "account_type = 'bot' -> 1 = Inauthentic (operational mapping); 'human' -> 0 = Authentic",
    "role_in_study": "headline X/Twitter result (replaces the synthetic dataset)",
    "ignored_assets": "profile_images/ and profile_background_images/ JPEG folders"
  },
  "class_balance": {
    "n_authentic": 25013,
    "n_inauthentic": 12425,
    "positive_rate": 0.3319
  },
  "split": {
    "method": "stratified_80_20",
    "seed": 42,
    "n_train": 29964,
    "n_test": 7474,
    "implementation": "common.stratified_split (sampleBy per class, anti-join)",
    "vendor_split_column": "ignored for the headline; used only in vendor_split_check"
  },
  "features": {
    "used": [
      "default_profile",
      "default_profile_image",
      "geo_enabled",
      "verified",
      "log_favourites_count",
      "log_followers_count",
      "log_friends_count",
      "follower_share",
      "log_average_tweets_per_day",
      "account_age_days",
      "has_description",
      "description_length",
      "has_location",
      "lang_onehot"
    ],
    "n_assembled_dimensions": 46,
    "lang_levels_kept": [
      "__missing__",
      "af",
      "ar",
      "ca",
      "cy",
      "da",
      "de",
      "en",
      "es",
      "et",
      "fi",
      "fr",
      "hr",
      "id",
      "it",
      "ja",
      "ko",
      "nl",
