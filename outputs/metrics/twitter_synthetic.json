{
  "platform": "twitter",
  "dataset": {
    "name": "Twitter Bot Detection Dataset (synthetic negative control)",
    "source": "kaggle: goyaladi/twitter-bot-detection-dataset",
    "file": "data/landing/twitter_bot_detection/bot_detection_data.csv",
    "n_rows": 50000,
    "label_col": "Bot Label",
    "positive_means": "Bot Label = 1 (bot) -> 1 = Inauthentic (operational mapping)",
    "role_in_study": "negative control - original Worksheet 2/3 dataset, shown to be generated noise and set aside"
  },
  "class_balance": {
    "n_authentic": 24982,
    "n_inauthentic": 25018,
    "positive_rate": 0.5004
  },
  "split": {
    "method": "stratified_80_20",
    "seed": 42,
    "n_train": 40128,
    "n_test": 9872,
    "implementation": "common.stratified_split (sampleBy per class, anti-join)"
  },
  "features": {
    "used": [
      "retweet_count",
      "mention_count",
      "follower_count",
      "verified",
      "tweet_hour",
      "tweet_day_of_week",
      "tweet_days_since_2020_01_01",
      "tweet_len_chars",
      "tweet_len_words",
      "has_hashtags",
      "hashtag_count",
      "tweet_tfidf",
      "hashtags_tfidf"
    ],
    "n_assembled_dimensions": 1949,
    "dropped": {
      "User ID": "identifier (contract rule 1)",
      "Username": "identifier (contract rule 1)",
      "Location": "free-text place name, 25199 distinct values in 50000 rows (median 2 rows per value); Faker city pattern with prefix/suffix unrelated to label (chi2 p = 0.9695 / 0.724)",
      "Created At": "decomposed into tweet_hour, tweet_day_of_week, tweet_days_since_2020_01_01"
    },
    "engineered": {
      "verified": "Verified == 'True' -> 1.0, 'False' -> 0.0 (no other values present)",
      "tweet_hour": "hour(Created At)",
      "tweet_day_of_week": "dayofweek(Created At), 1 = Sunday",
      "tweet_days_since_2020_01_01": "datediff(Created At, 2020-01-01)",
      "tweet_len_chars": "length(Tweet)",
      "tweet_len_words": "number of whitespace-separated words in Tweet",
      "has_hashtags": "Hashtags not empty (NULL = tweet had no hashtags)",
      "hashtag_count": "number of hashtags; 0 when the tweet had none (a true zero)",
      "tweet_tfidf": "RegexTokenizer -> CountVectorizer(vocabSize=1000, minDF=5) -> IDF(minDocFreq=5) on Tweet",
      "hashtags_tfidf": "same TF-IDF chain on Hashtags"
    },
    "missing_values": "Only Hashtags has NULLs (16.7%); NULL means the tweet carried no hashtags, so it becomes an empty list. Every model input is asserted NULL-free; nothing is zero-filled.",
    "class_weights": {
      "0": 1.0014,
      "1": 0.9986,
      "train_counts": {
        "1": 20092,
        "0": 20036
      },
      "formula": "n_train / (2 * n_class)"
    }
  },
  "models": {
    "random_forest": {
      "params": {
        "numTrees": 150,
        "featureSubsetStrategy": "sqrt",
        "impurity": "gini",
